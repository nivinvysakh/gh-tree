{
  "name": "gh-tree",
  "version": "1.2.0",
  "description": "Renders your GitHub contribution graph as an animated Minecraft Oak Tree (leaves = commits, flowers = open PRs, red apples = merged PRs, golden apples = assigned PRs).",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:mock": "tsx scripts/generate-mock.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
